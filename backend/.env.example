# Get free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secret

# SQLite file path (default is fine for local/free deployment)
DATABASE_URL=sqlite:///./neuralix_rag.db

# Where uploaded docs + FAISS indexes are stored
STORAGE_DIR=./storage
